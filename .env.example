# Copier en .env et remplir. Ne jamais versionner .env.
# Seule l'infrastructure est ici : courriel, réseaux sociaux et sources se règlent dans /gestion/reglages/.
DJANGO_DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=à-générer
# Chiffre les secrets enregistrés dans /gestion/reglages/ ; la perdre oblige à les ressaisir.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=à-générer
DJANGO_ALLOWED_HOSTS=nice-event.fr,www.nice-event.fr
DJANGO_CSRF_TRUSTED_ORIGINS=https://nice-event.fr,https://www.nice-event.fr
SITE_URL=https://nice-event.fr
# Derrière Caddy (VPS1) : True ; jamais sans reverse proxy (l'en-tête serait falsifiable)
TRUST_X_FORWARDED_FOR=True
