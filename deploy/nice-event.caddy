# Nice-Event (~/Nice-Event) : copié dans ~/reverse-proxy/sites/ sur VPS1. En-têtes de sécurité (CSP, HSTS…) posés par Django.
nice-event.fr {
	request_body {
		max_size 15MB
	}
	# Fond de carte (PMTiles) : servi tel quel, sans compression qui casserait les requêtes par plages
	handle_path /tiles/* {
		reverse_proxy nice-event_tiles:80
	}
	handle {
		encode zstd gzip
		reverse_proxy nice-event_web:8000
	}
}
www.nice-event.fr {
	redir https://nice-event.fr{uri} permanent
}
# Beta (~/Nice-Event-beta, branche main) : copie de la base de prod sans secrets ni tâches de fond, hors des moteurs de recherche.
beta.nice-event.fr {
	header >X-Robots-Tag "noindex, nofollow"
	request_body {
		max_size 15MB
	}
	handle_path /tiles/* {
		reverse_proxy nice-event-beta_tiles:80
	}
	handle {
		encode zstd gzip
		reverse_proxy nice-event-beta_web:8000
	}
}
