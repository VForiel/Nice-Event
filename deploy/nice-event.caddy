# Nice-Event (~/Nice-Event) : copié dans ~/reverse-proxy/sites/ sur VPS1. En-têtes de sécurité (CSP, HSTS…) posés par Django.
nice-event.fr {
	request_body {
		max_size 15MB
	}
	# Fond de carte (PMTiles) : servi tel quel, sans compression qui casserait les requêtes par plages
	handle_path /tiles/* {
		reverse_proxy nice-event_tiles:80
	}
	handle {
		encode zstd gzip
		reverse_proxy nice-event_web:8000
	}
}
www.nice-event.fr {
	redir https://nice-event.fr{uri} permanent
}
